<UserControl x:Class="Effanville.FPD.AvaloniaUI.Windows.Common.SelectedSingleDataView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Effanville.FPD.AvaloniaUI.Windows.Common"
             xmlns:common="clr-namespace:Effanville.FPD.Logic.ViewModels.Common;assembly=Effanville.FPD.Logic"
             d:DataContext="{d:DesignInstance Type=common:SelectedSingleDataViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
			 d:DesignWidth="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<StackPanel Orientation="Horizontal"
                    Height="40"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Grid.Column="0">
			<Button Content="Delete Valuation"
                    Command="{Binding DeleteValuationCommand}"
                    ToolTip.Tip="Deletes the data highlighted." />
			<Button Content="Import Data"
                    Command="{Binding AddCsvDataCommand}"
                    ToolTip.Tip="Adds data to the selected account from a csv file." />
			<Button Content="Export Data"
                    Command="{Binding ExportCsvDataCommand}"
                    ToolTip.Tip="Exports data from the selected account to a csv file." />
		</StackPanel>
		<ContentControl Grid.Row="1"
                        Grid.Column="0"
                        Content="{Binding TLVM}" />
		<ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding Stats}"/>
		<GridSplitter Grid.Row="1"
                      Grid.Column="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Width="5"/>
		<Grid Grid.Row="1"
              Grid.Column="3"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
			<TextBlock>Charting Not yet implemented</TextBlock>
		</Grid>
	</Grid>
</UserControl>
