<UserControl x:Class="Effanville.FPD.UI.Av.Windows.Asset.SelectedAssetView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:asset="clr-namespace:Effanville.FPD.Logic.ViewModels.Asset;assembly=Effanville.FPD.Logic"
             d:DataContext="{d:DesignInstance Type=asset:SelectedAssetViewModel}"
             mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal">
			<Button Content="Download"
                    Command="{Binding DownloadCommand}"
                    ToolTip.Tip="Press here to download data for selected." />
			<Button Content="Export Data"
                    Command="{Binding ExportCsvData}"
                    ToolTip.Tip="Exports data from the selected security to a csv file." />
		</StackPanel>
		<Grid Grid.Column="0"
              Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ContentControl Content="{Binding ValuesTLVM}"
                            Grid.Row="0"
                            Grid.Column="0" />
			<ContentControl Content="{Binding DebtTLVM}"
                            Grid.Row="0"
                            Grid.Column="1" />
			<ContentControl Content="{Binding PaymentsTLVM}"
                            Grid.Row="0"
                            Grid.Column="2" />
		</Grid>
		<ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding Statistics}" />
		<Grid Grid.Row="1"
              Grid.Column="2"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
			<TextBlock>Charting Not yet implemented</TextBlock>
		</Grid>
	</Grid>
</UserControl>
