<UserControl x:Class="Effanville.FPD.UI.Windows.Common.AddEditNameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Effanville.FPD.UI.Windows.Common"
             xmlns:common="clr-namespace:Effanville.FPD.Logic.ViewModels.Common;assembly=Effanville.FPD.Logic"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=common:AddEditNameViewModel}">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MaxWidth="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="20" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Account Details:"
                   Margin="2" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Broker:"
                   Margin="2" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Visibility="{Binding DisplayBroker, Converter={StaticResource BoolToVis}}"
                 Text="{Binding Broker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2"/>
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Company:"
                   Margin="2" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Visibility="{Binding DisplayCompany, Converter={StaticResource BoolToVis}}"
                 Text="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2" />
        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Name:"
                   Margin="2" />
        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2" />
        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Url:"
                   Margin="2" />
        <TextBox Grid.Row="4"
                 Grid.Column="1"
                 Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2" />
        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Text="Currency:"
                   Margin="2" />
        <TextBox Grid.Row="5"
                 Grid.Column="1"
                 Text="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2"/>
        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Text="Sectors:"
                   Margin="2" />
        <TextBox Grid.Row="6"
                 Grid.Column="1"
                 Text="{Binding Sectors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2" />
        <TextBlock Grid.Row="7"
                   Grid.Column="0"
                   Text="Notes:"
                   Margin="2" />
        <TextBox Grid.Row="7"
                 Grid.Column="1"
                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0"
                 Margin="2"/>
        <Button Grid.Row="8"
                Grid.ColumnSpan="2"
                Grid.Column="0"
                HorizontalAlignment="Center"
                Content="{Binding CommandName}"
                Command="{Binding CompleteCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    </Grid>
</UserControl>
