<UserControl
    x:Class="Effanville.FPD.UI.Windows.Stats.StatsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stats="clr-namespace:Effanville.FPD.Logic.ViewModels.Stats;assembly=Effanville.FPD.Logic"
    xmlns:ui="clr-namespace:Effanville.FPD.UI"
    d:DataContext="{d:DesignInstance Type=stats:StatsViewModel}"
    mc:Ignorable="d"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ui:StatisticToStringConverter x:Key="statConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  IsChecked="{Binding DisplayValueFunds}"
                  Content="Only Display Funds with current value" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  FlowDirection="LeftToRight"
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="3">
            <ItemsControl Grid.Row="1"
                      Grid.Column="0"
                      Margin="3"
                      DataContext="{Binding}"
                      ItemsSource="{Binding StatisticNames}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Instance, Converter={StaticResource statConverter}}"
                              IsChecked="{Binding Selected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DataGrid Margin="5"
                  AutoGenerateColumns="false"
                  Grid.Row="1"
                  Grid.Column="1"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserReorderColumns="False"
                  Height="Auto"
                  ItemsSource="{Binding StatsDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsReadOnly="True"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="None"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  x:Name="StatsBox"
                  x:FieldModifier="private" />
    </Grid>
</UserControl>